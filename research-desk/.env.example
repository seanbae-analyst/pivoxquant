# Anthropic API 키. https://console.anthropic.com 에서 발급. 서버에서만 읽는다 (NEXT_PUBLIC_ 아님).
ANTHROPIC_API_KEY=

# 선택. 기본값은 claude-opus-5. 비용을 낮추려면 claude-sonnet-5.
RESEARCH_MODEL=

# 선택. 하위 질문 하나당 웹 검색 최대 횟수 (기본 6). 반증 단계는 이 값 + 2.
RESEARCH_MAX_SEARCHES=

# 선택. 노출할 분야 목록 (쉼표 구분). 데이터 전용 사이트면 "data". 비면 전부(data, consulting).
NEXT_PUBLIC_RESEARCH_DOMAINS=
# 선택. 기본 분야. 비면 노출 목록의 첫 번째.
NEXT_PUBLIC_RESEARCH_DOMAIN=

# ── 지식 베이스 (질의응답) ──
# Voyage AI 키 — 임베딩(voyage-4)과 재정렬(rerank-2.5). https://www.voyageai.com
VOYAGE_API_KEY=
# 선택. 기본 voyage-4 / rerank-2.5. 재정렬을 끄려면 KB_RERANK=0.
VOYAGE_EMBED_MODEL=
VOYAGE_RERANK_MODEL=
KB_RERANK=
# 저장소. 비면 kb/index.json 파일(로컬·소규모). Postgres+pgvector 를 쓰려면 접속 문자열 (스키마: db/schema.sql).
DATABASE_URL=
# 선택. 파일 저장소 경로 (기본 kb/index.json).
KB_INDEX_PATH=
