name: Self-Healing (Layer C)

# Scans Railway runtime logs for recurring errors and proposes fixes.
#
# DRY RUN semantics (corrected 2026-08-30)
# ----------------------------------------
# The old header claimed "Defaults to DRY RUN", but the guards were
# `github.event.inputs.dry_run != 'true'`. `dry_run`'s default: 'true'
# applies to workflow_dispatch ONLY — on `schedule` (and
# `repository_dispatch`) the inputs context is empty, so '' != 'true'
# was TRUE and every cron run invoked Claude for real. With repo vars
# AUTOFIX_ENABLED=1 that reached the auto-PR path too.
# Every guard is now anchored on `github.event_name == 'workflow_dispatch'`,
# so schedule/repository_dispatch are ALWAYS dry run (scan + upload
# artifacts only) and only an explicit manual run with dry_run=false
# can call Claude. Draft PRs additionally require auto_pr=true AND the
# AUTOFIX_ENABLED repo variable.
#
# Safety
# ------
# - Protected paths (autotrader, risk_defense, legal_filter, billing,
#   auth, security, migrations) NEVER auto-patched; escalation only.
# - 24h circuit breaker: 3 failed attempts on the same fingerprint
#   stops retries and opens an escalation issue.
# - pytest gate: proposed patch MUST keep pytest -q passing before the
#   Draft PR is opened.

on:
  schedule:
    # 2026-04-29 cost reduction: was every 2h (~360 runs/mo at ~5min each),
    # now every 12h. Since 2026-08-30 cron is ALWAYS dry run (scan +
    # artifact upload only; it cannot call Claude or open a PR), so this
    # cadence only controls how often patterns are collected.
    - cron: '0 */12 * * *'   # every 12 hours, UTC
  workflow_dispatch:
    inputs:
      dry_run:
        description: 'Dry run (skip Claude + skip PR). Default true.'
        required: false
        default: 'true'
      auto_pr:
        description: 'Open Draft PR if patch passes pytest. Default false.'
        required: false
        default: 'false'
  repository_dispatch:
    types: [sentry.issue]

permissions:
  issues: write
  contents: write
  pull-requests: write
  id-token: write   # required by anthropics/claude-code-action@v1 OAuth flow

jobs:
  heal:
    name: Scan + propose fix
    runs-on: ubuntu-latest
    timeout-minutes: 20
    continue-on-error: true   # alerting, not gating

    # Effective auto-PR flag (rewritten 2026-08-30).
    # Previously schedule/repository_dispatch fell back to the
    # AUTOFIX_ENABLED repo variable — and that variable is currently set
    # to 1, so unattended cron runs could apply patches and open PRs.
    # Auto-PR now requires ALL of: a manual workflow_dispatch, an explicit
    # dry_run=false, auto_pr=true, and AUTOFIX_ENABLED=1. Cron can never
    # satisfy the first condition, so cron is structurally scan-only.
    #   gh variable set AUTOFIX_ENABLED --body 1 --repo seanbae-analyst/pivoxquant
    env:
      AUTOFIX_ON: ${{ github.event_name == 'workflow_dispatch' && github.event.inputs.dry_run != 'true' && github.event.inputs.auto_pr == 'true' && vars.AUTOFIX_ENABLED == '1' }}

    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 100

      - uses: actions/setup-python@v6
        with:
          python-version: '3.12'
          cache: pip

      - name: Install deps
        run: |
          pip install -r requirements.txt || echo "::warning::requirements install failed"
          pip install pytest pytest-flask

      - name: Install Railway CLI (best-effort)
        continue-on-error: true
        run: |
          curl -fsSL https://railway.app/install.sh | sh || echo "::warning::Railway CLI install failed — fixture fallback will be used"

      - name: Scan Railway logs for recurring errors
        env:
          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}
          RAILWAY_SERVICE: ${{ vars.RAILWAY_SERVICE || 'web' }}
          SELF_HEALING_DRY_RUN: '1'   # scan phase is always observation
          RAILWAY_WINDOW_MINUTES: '60'
          RAILWAY_MIN_COUNT: '3'
        run: python3 scripts/self_healing/scan_railway_logs.py

      # ── Migrated 2026-05-03 from `pip install anthropic` + ANTHROPIC_API_KEY
      #    to `claude-code-action@v1` + CLAUDE_CODE_OAUTH_TOKEN (Claude Max
      #    subscription). See docs/CLAUDE_CODE_OAUTH_SETUP.md.
      #
      #    The Python script `scripts/self_healing/propose_fix.py` is preserved
      #    on disk for local testing with SELF_HEALING_DRY_RUN=1; CI no longer
      #    invokes it. The system prompt below mirrors propose_fix.py:50-64
      #    (SYSTEM_PROMPT) verbatim. The action's Claude must write each
      #    proposed unified diff to `self_healing_artifacts/patches/<fp>.patch`
      #    so downstream `Apply patch + run pytest` step glob remains valid.

      - name: Propose fix patches via Claude Code Action
        # Manual + explicit dry_run=false only. schedule/repository_dispatch
        # carry no inputs, so this is always false for them (2026-08-30).
        if: ${{ github.event_name == 'workflow_dispatch' && github.event.inputs.dry_run != 'true' }}
        uses: anthropics/claude-code-action@v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          # `allowed_tools` is NOT a valid input on @v1 — pass via claude_args.
          # Verified syntax (2026-05-03) from
          # https://github.com/anthropics/claude-code-action/blob/main/examples/ci-failure-auto-fix.yml:
          #   claude_args: "--allowedTools 'Edit,MultiEdit,Write,Read,Glob,Grep,LS,Bash(git:*),Bash(gh:*)'"
          # Comma-separated, `Bash(<cmd>:*)` with COLON, outer double + inner single quotes.
          claude_args: "--max-turns 25 --model claude-sonnet-4-6 --allowedTools 'Read,Write,Grep,Glob,Bash(gh issue create:*),Bash(gh pr:*),Bash(git log:*),Bash(git show:*),Bash(git diff:*)'"
          prompt: |
            You are PivoxQuant's self-healing layer (Layer C).

            ## Inputs on disk
            - `self_healing_artifacts/railway_patterns.jsonl` — one JSON object
              per recurring error pattern (fields: fingerprint, file, line,
              exception, message, count, sample_lines).
            - `self_healing_artifacts/history.json` — past attempts (24h
              circuit breaker; 3 failed attempts on the same fingerprint =
              skip + escalate).

            ## Task
            For up to **2** of the highest-count patterns:
            1. Read the pattern's `file` at lines `max(1, line-40) .. line+40`
               for context.
            2. **Protected-path allowlist** — NEVER auto-patch:
               - `autotrader.py`, `services/trading/autotrader.py`
               - `risk_defense.py`, `services/quant/risk_*`
               - `services/legal*`, `routes/auth*`, `security.py`
               - `migrations/`, `billing/`
               If the pattern's file matches any of these, do NOT generate a
               patch — instead `gh issue create` with title
               `[Self-healing] Cannot auto-fix <fingerprint> — protected path`
               and label `autopilot,self-heal,escalation`.
            3. Otherwise produce a MINIMAL unified diff that plausibly fixes
               the root cause without changing public behavior. Write it to
               `self_healing_artifacts/patches/<fingerprint>.patch` using the
               Write tool.
            4. If the root cause is unclear, write the single line
               `INSUFFICIENT_EVIDENCE` to the patch file (the apply step
               will skip it on `git apply --check` failure).

            ## Strict patch rules (mirror propose_fix.py:50-64)
            - Output only a unified diff (`--- a/...` / `+++ b/...`) — no
              prose, no code fences inside the patch file.
            - Do NOT touch files outside the one in the error.
            - Do NOT add new dependencies.
            - Do NOT silently swallow exceptions — `try/except` MUST log
              the exception and return a safe fallback, never `pass`.
            - Never modify kill-switch values or compliance-sensitive
              constants (`enabled`, `legal_status`, autotrader flags).

            ## Output budget
            One patch per pattern, max 2 patterns per run. Stop after writing
            the second patch even if more patterns exist.

      - name: Dry-run notice
        # Exact negation of the Claude step above, so exactly one of the
        # two always runs (2026-08-30).
        if: ${{ !(github.event_name == 'workflow_dispatch' && github.event.inputs.dry_run != 'true') }}
        run: |
          echo "::notice::dry run (event=${{ github.event_name }}) → skipped Claude Code Action invocation."
          echo "::notice::Patterns scanned but no patches generated. Inspect self_healing_artifacts/railway_patterns.jsonl in the artefact bundle."

      - name: Apply patch + run pytest (only if patches exist and autofix on)
        if: ${{ env.AUTOFIX_ON == 'true' && github.event_name == 'workflow_dispatch' && github.event.inputs.dry_run != 'true' }}
        id: apply
        run: |
          set -e
          mkdir -p self_healing_artifacts/patches
          applied_count=0
          applied_files=()
          for patch in self_healing_artifacts/patches/*.patch; do
            [ -e "$patch" ] || continue
            fp=$(basename "$patch" .patch)
            # Create a candidate branch for this fingerprint
            branch="self-heal/${fp}-$(date -u +%s)"
            git checkout -b "$branch" origin/main
            if ! git apply --check "$patch" 2>/tmp/apply_check.log; then
              echo "::warning::patch $fp failed pre-check — skipping"
              cat /tmp/apply_check.log
              continue
            fi
            git apply "$patch"
            # pytest gate
            if ! pytest -q --tb=short > /tmp/pytest_${fp}.log 2>&1; then
              echo "::warning::patch $fp broke pytest — reverting"
              git checkout -- .
              continue
            fi
            git config user.email "self-healing@pivoxquant.com"
            git config user.name "PivoxQuant Self-Heal Bot"
            git add -A
            git commit -m "auto-heal: fix recurring error ${fp}"
            applied_count=$((applied_count + 1))
            applied_files+=("$branch")
          done
          echo "applied_count=${applied_count}" >> "$GITHUB_OUTPUT"

      - name: Open Draft PR (only if AUTO_PR=1 and a patch was applied)
        # 2026-08-30: added the explicit AUTOFIX_ON re-check. The previous
        # guard relied solely on the skipped apply step yielding an empty
        # output — correct but implicit; make the dry-run contract explicit.
        if: ${{ env.AUTOFIX_ON == 'true' && steps.apply.outputs.applied_count != '' && steps.apply.outputs.applied_count != '0' }}
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # Push the last candidate branch and open a Draft PR. We
          # deliberately open one PR per run — if multiple patches were
          # applied, only the final branch is pushed (the others were
          # local-only). Refactor later if multi-fix per run is needed.
          branch=$(git rev-parse --abbrev-ref HEAD)
          git push origin "$branch"
          gh pr create \
            --draft \
            --base main \
            --head "$branch" \
            --title "auto-heal: recurring Railway error" \
            --body "Automated fix proposal. See self_healing_artifacts/ for patterns + patch. Human review required before merging."

      - name: Upload artifacts
        uses: actions/upload-artifact@v7
        if: always()
        with:
          name: self-healing-${{ github.run_id }}
          path: |
            self_healing_artifacts/
          retention-days: 14
