# Trufflehog secret scan — runs on every PR + push to main.
# Free tier (OSS, no SaaS). Source: 2026-05-10 security wave §5.2.
name: Secret Scan

on:
  pull_request:
  push:
    branches: [main]

jobs:
  trufflehog:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - name: Trufflehog OSS scan
        uses: trufflesecurity/trufflehog@v3.91.1
        with:
          base: ${{ github.event.repository.default_branch }}
          head: HEAD
          extra_args: --only-verified
