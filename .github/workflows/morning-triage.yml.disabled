name: Morning Triage (Layer B)

# 00:00 UTC = 09:00 KST — runs ~1h after nightly-bug-hunt (02:00 KST)
# has finished opening/updating issues. Reads the freshest open
# `nightly-bug-hunt` issue(s) and posts a Claude-generated root-cause
# analysis as a comment. Advisory only — never modifies code.
#
# DRY RUN semantics (corrected 2026-08-30)
# ----------------------------------------
# The guard used to be `github.event.inputs.dry_run != 'true'`. The
# `default: 'true'` below applies to workflow_dispatch ONLY — on
# `schedule` the inputs context is empty, so '' != 'true' was TRUE and
# every 09:00 KST cron run really called Claude and really posted issue
# comments. The guard is now anchored on the event name: schedule is
# ALWAYS dry run, and only a manual run with dry_run=false calls Claude.

on:
  schedule:
    - cron: '0 0 * * *'   # 00:00 UTC = 09:00 KST
  workflow_dispatch:
    inputs:
      dry_run:
        description: 'Skip Claude calls + GH comments (true/false)'
        required: false
        default: 'true'
      max_issues:
        description: 'Max issues to analyse (default 3)'
        required: false
        default: '3'

permissions:
  issues: write
  contents: read
  id-token: write   # required by anthropics/claude-code-action@v1 OAuth flow

jobs:
  triage:
    name: Claude triage
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # Advisory only — never fail the workflow. The comment is the signal.
    continue-on-error: true

    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 50   # needed for `git log -n 1` on referenced files

      # ── Migrated 2026-05-03 from `pip install anthropic` + ANTHROPIC_API_KEY
      #    to `claude-code-action@v1` + CLAUDE_CODE_OAUTH_TOKEN (Claude Max
      #    subscription). See docs/CLAUDE_CODE_OAUTH_SETUP.md for one-time
      #    `claude setup-token` flow.
      #
      #    The Python script `scripts/triage/morning_triage.py` is preserved on
      #    disk for local smoke-testing with TRIAGE_DRY_RUN=1; CI no longer
      #    invokes it. The system prompt + 5-section output format below
      #    mirrors `morning_triage.py:49-80` (SYSTEM_PROMPT) verbatim so
      #    behaviour stays consistent.

      - name: Run morning triage via Claude Code Action
        # Manual + explicit dry_run=false only; schedule carries no inputs
        # so this is always false for cron (2026-08-30).
        if: ${{ github.event_name == 'workflow_dispatch' && github.event.inputs.dry_run != 'true' }}
        uses: anthropics/claude-code-action@v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          # `allowed_tools` is NOT a valid input on @v1 — must go via claude_args.
          # Verified syntax (2026-05-03) from
          # https://github.com/anthropics/claude-code-action/blob/main/examples/ci-failure-auto-fix.yml:
          #   claude_args: "--allowedTools 'Edit,MultiEdit,Write,Read,Glob,Grep,LS,Bash(git:*),Bash(npm:*),Bash(gh:*)'"
          # Comma-separated tools, `Bash(<cmd>:*)` glob with COLON, outer double quotes
          # + inner single quotes. Space-separated form silently fails (permission_denials_count: 9).
          claude_args: "--max-turns 25 --model claude-sonnet-4-6 --allowedTools 'Read,Grep,Glob,Bash(gh issue list:*),Bash(gh issue view:*),Bash(gh issue comment:*),Bash(gh api:*),Bash(git log:*),Bash(git show:*)'"
          prompt: |
            You are PivoxQuant's morning triage (Layer B, 09:00 KST daily).

            PivoxQuant is a Flask 3 + Next.js 16 Korean retail investment
            platform (Railway + Vercel, PostgreSQL, Alpaca/KIS/FMP).

            ## Task
            1. Use `gh issue list --repo ${{ github.repository }} --state open
               --label nightly-bug-hunt --json number,title,body,labels,updatedAt
               --limit 20` to fetch open bug-hunt issues.
            2. Pick the top ${{ github.event.inputs.max_issues || '3' }} by
               severity (label priority: critical > high > medium > low),
               then by most recently updated.
            3. For each chosen issue, read the body + any referenced files in
               the repo (use `git log -n 1 -- <file>` for recency context).
            4. Post a root-cause analysis comment using `gh issue comment
               <number> --body-file <tmp>` in the EXACT 5-section format
               below. Never modify code — this is advisory-only.

            ## Strict rules
            - Never invent evidence. If data is insufficient, say
              "INSUFFICIENT_EVIDENCE" and list exactly what additional data is
              needed.
            - Do NOT recommend buying, selling, or holding any security.
              This is an infrastructure context, not advisory.
            - Respect the kill switch: `enabled=false` and
              `legal_status=pending-counsel-review` on /api/agent/status are
              intentional and MUST NOT be "fixed" to `true`.

            ## Output format per issue (markdown)
            ## Root Cause (most likely)
            <one paragraph, cite specific file:line or endpoint from evidence>

            ## Confidence
            <low|medium|high> — <one sentence justification>

            ## Fix proposal (max 3 lines)
            1. <concrete change: file + diff sketch>
            2. <concrete change>
            3. <concrete change or "n/a">

            ## Verification
            <one-liner test or curl that will prove the fix>

      - name: Dry-run notice
        # Exact negation of the step above, so exactly one of the two runs.
        if: ${{ !(github.event_name == 'workflow_dispatch' && github.event.inputs.dry_run != 'true') }}
        run: |
          echo "::notice::dry run (event=${{ github.event_name }}) → skipped Claude Code Action invocation."
          echo "::notice::Run locally with TRIAGE_DRY_RUN=1 python3 scripts/triage/morning_triage.py to inspect prompts."
