# ══════════════════════════════════════════════════════════════════════════════
# PivoxQuant Backend — Environment Variables (Example)
# ══════════════════════════════════════════════════════════════════════════════
# NEVER commit real values. Copy this file to `.env` (gitignored) and fill in.
# Production secrets live in Railway → Variables tab.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Railway PostgreSQL connection string (sslmode=require enforced in production)
# Leave empty or omit for local SQLite dev.
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ── App Core ──────────────────────────────────────────────────────────────────
# Application mode — "production" enables strict security defaults (secure
# cookies, CORS allow-list enforced, debug OFF). Use "development" locally.
FLASK_ENV=production

# Comma-separated list of origins allowed to call the API with credentials.
# In production, these MUST be HTTPS. The first entry is also used as the
# default issuer for absolute OAuth redirects. Keep in sync with Vercel.
CORS_ORIGINS=https://pivoxquant.com,https://www.pivoxquant.com,https://pivoxquant.vercel.app

# Public frontend origin — used for OAuth redirect URIs, password-reset
# links, share URLs, and any place the backend needs an absolute URL to the
# SPA. Must match one of CORS_ORIGINS above.
FRONTEND_URL=https://pivoxquant.com

# Session cookie domain. A leading "." lets the same session cover the
# apex + www + any api/preview subdomains under pivoxquant.com. Leave
# UNSET for local dev (single-host, no subdomain sharing).
SESSION_COOKIE_DOMAIN=.pivoxquant.com

# Flask-Limiter backend. "memory://" is fine for a single-worker deploy —
# switch to redis://... behind a load balancer. Leaving unset defaults to
# memory storage and warns at boot.
RATELIMIT_STORAGE_URI=memory://

# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<YOUR_SECRET_KEY>

# Broker credential encryption key (CRITICAL — DO NOT ROTATE without re-encrypting
# existing credentials, or all KIS/Alpaca connections will be permanently unreadable).
# Used by services/crypto_service.py (AES-256-GCM) to encrypt broker app keys at rest.
# If unset, a random ephemeral key is generated at process start, meaning every
# Railway restart permanently invalidates existing encrypted credentials (data loss).
# Generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PIVOX_BROKER_ENCRYPTION_KEY=<base64_32bytes_key>

# (legacy — currently unused) MASTER_KEY predates PIVOX_BROKER_ENCRYPTION_KEY and is
# not referenced by any current code path. Do NOT confuse with the variable above.
# Remove entirely once verified unused across all environments.
MASTER_KEY=<YOUR_MASTER_KEY>

# CSRF token signing secret (separate from SECRET_KEY for rotation independence)
CSRF_SECRET=<YOUR_CSRF_SECRET>

# ── OAuth: Google ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# ── OAuth: Kakao ──────────────────────────────────────────────────────────────
KAKAO_CLIENT_ID=<YOUR_KAKAO_REST_API_KEY>
KAKAO_CLIENT_SECRET=<YOUR_KAKAO_CLIENT_SECRET>

# ── AI / Claude ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_KEY>

# ── Market Data: FMP (Financial Modeling Prep) ────────────────────────────────
FMP_API_KEY=<YOUR_FMP_KEY>

# ── Macro Data: FRED (Federal Reserve Economic Data) ──────────────────────────
# Free API key — register at: https://fred.stlouisfed.org/docs/api/api_key.html
# Powers /api/alt-data/macro/* endpoints (snapshot, series, regime). When
# unset, those endpoints return HTTP 503 with code=FRED_NOT_CONFIGURED.
FRED_API_KEY=<YOUR_FRED_KEY>

# ── Broker: Alpaca (US, paper trading) ────────────────────────────────────────
ALPACA_API_KEY=<YOUR_ALPACA_KEY>
ALPACA_SECRET_KEY=<YOUR_ALPACA_SECRET>

# ── Broker: KIS (한국투자증권, read-only) ─────────────────────────────────────
KIS_APP_KEY=<YOUR_KIS_APP_KEY>
KIS_APP_SECRET=<YOUR_KIS_APP_SECRET>
# Set to "1" for real account, "0" for mock/paper. Default: 0 (mock).
KIS_USE_REAL=0
# KIS account number (8 digits before the hyphen). Pair with KIS_ACCOUNT_PROD
# (2-digit product code — "01" for CMA/equities).
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PROD=01

# ── Payment: Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_PRICE_PRO=<YOUR_STRIPE_PRICE_ID_PRO>
STRIPE_PRICE_PREMIUM=<YOUR_STRIPE_PRICE_ID_PREMIUM>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>

# ── Beta Gate ─────────────────────────────────────────────────────────────────
# Password for the beta access gate (closed beta). Rotate before public launch.
BETA_PASSWORD=<YOUR_BETA_PASSWORD>

# ── Feature Flags ─────────────────────────────────────────────────────────────
# "1" to enable background scheduler (signal refresh, cache warmup, etc.)
RUN_SCHEDULER=0
# "1" to enable the internal command center dashboard (admin-only)
ENABLE_COMMAND_CENTER=0
# "1" to populate FMP cache on app boot (slower startup, faster first requests)
POPULATE_CACHE_ON_BOOT=0

# ── Monthly Brag Card (1st of month 09:00 KST) ────────────────────────────────
# Sender for the 9:16 Instagram-Story PNG email. Must be a verified
# sender in SendGrid (or the matching domain in SPF/DKIM for SMTP).
BRAG_CARD_FROM_EMAIL=reports@pivoxquant.com
# Public origin used in share URLs stamped onto the card + in the email's
# Instagram/KakaoTalk/X deep links. Use the apex domain in production.
BRAG_CARD_SHARE_BASE_URL=https://pivoxquant.com
# Apex used by the legacy `/monthly-brag/share-link` endpoint for OG meta
# and /r/<ref>?brag=<id> referral deep-links. Usually identical to the
# base URL above minus the scheme.
MONTHLY_BRAG_SHARE_DOMAIN=pivoxquant.com
# Local storage for rendered PNGs (default: <project>/artifacts/brag_card).
# Point at a mounted volume in production to survive container restarts.
# BRAG_CARD_STORAGE_DIR=/data/artifacts/brag_card

# ── Weekly Investor Memo (Sunday 08:00 KST) ───────────────────────────────────
# Sender address for the PDF memo email. Must be a verified sender in SendGrid
# (or the matching domain in SPF/DKIM for SMTP).
WEEKLY_MEMO_FROM_EMAIL=reports@pivoxquant.com
# Local filesystem path where generated PDFs are written (default
# <project>/artifacts/weekly_memo). Set to a mounted volume for Railway.
# WEEKLY_MEMO_STORAGE_DIR=/data/artifacts/weekly_memo

# ── Earnings Pre-Brief (event-triggered, T-30 before announcement) ────────────
# Sender address for the urgent 2-page PDF + Warm Gold email. Falls back to
# WEEKLY_MEMO_FROM_EMAIL when unset, so setting this is optional in dev.
EARNINGS_PREBRIEF_FROM_EMAIL=reports@pivoxquant.com
# Lead time in minutes between the scan match and the earnings announcement.
# The scheduler runs every 15 minutes; the scan's ±6-min tolerance around
# this value guarantees exactly one match per announcement.
EARNINGS_PREBRIEF_LEAD_MINUTES=30
# Local storage for archived PDFs (default: <project>/artifacts/earnings_prebrief).
# Mount a volume in production so restarts preserve download links.
# EARNINGS_PREBRIEF_STORAGE_DIR=/data/artifacts/earnings_prebrief

# ── Email delivery (SendGrid preferred, SMTP fallback) ────────────────────────
# SendGrid — free tier ships 100 emails/day, plenty for a Sunday run.
SENDGRID_API_KEY=<YOUR_SENDGRID_KEY>
# SMTP fallback — used only if SENDGRID_API_KEY is unset.
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=<YOUR_SMTP_USER>
# SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=<YOUR_SENTRY_DSN>

# ── QA / E2E (dev-login bypass) ───────────────────────────────────────────────
# SECURITY: Leave UNSET in production. When unset, /api/auth/dev-login returns 404.
# Only set during QA sessions, then delete from Railway immediately after.
# DEV_LOGIN_SECRET=<OPTIONAL_QA_ONLY_SECRET>

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Required for the /api/push/subscribe flow. Generate with:
#   npx web-push generate-vapid-keys
# The PUBLIC key lives in the frontend (NEXT_PUBLIC_VAPID_PUBLIC_KEY); keep
# this one server-side only. The email MUST be a mailto: URL — web-push
# servers reject plain addresses.
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:seanbae1521@gmail.com

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated list of email addresses treated as admins. Admin-only
# routes (scheduler triggers, command center, deletion tools) check
# `current_user.email in ADMIN_EMAILS`. Empty → no admins, safe default.
ADMIN_EMAILS=seanbae1521@gmail.com
