# Per-user artifact storage (Premium PDF outputs / monthly_brag PNGs)
# — written by services in services/artifacts/*; project-root-level dir.
# Per-user PDFs land at artifacts/{kind}/{user_id}/.
# Leading slash anchors at repo root so we don't accidentally hide
# services/artifacts/ source code.
/artifacts/

# Nightly bug hunt local artifacts
nightly_artifacts/
.bughunt-*/

# Autonomous ops local artifacts (Layer B/C + legal monitor)
self_healing_artifacts/
legal_monitor_artifacts/

# agent-ops telemetry
.bkit/state/agent_telemetry.jsonl
nightly_artifacts/
self_healing_artifacts/
legal_monitor_artifacts/

# Bug hunt session artifacts (transient — not meant for git)
.bug-hunt/

# APScheduler runtime state (Wave H) — not source-of-truth
state/

# V2 smoke QA screenshots — binary blobs, stored by hash in MANIFEST.txt only.
# To reproduce: run scripts/v2-smoke.sh (or the worktree capture script).
# MANIFEST.txt files in qa/ ARE committed (text, ~3KB each).
qa/v2-smoke/**/*.png
