{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "PivoxQuant",
      "runtimeExecutable": "venv/bin/python",
      "runtimeArgs": ["run.py"],
      "port": 5050
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "source $HOME/.nvm/nvm.sh && cd frontend && npx next dev --port $PORT"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
