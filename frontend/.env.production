# PivoxQuant — Production env (Vercel/Next.js)
# 본 파일은 frontend build-time 환경변수 (NEXT_PUBLIC_*).
# Vercel 대시보드에 같은 값 입력하면 본 파일 무시 가능 (Vercel 우선).
#
# REAL PRODUCT (2026-06-26): demo mode OFF — prod is the login-gated real product
# backed by the live Railway backend (real OAuth, real data, real PDF generation +
# email delivery). All features free for every authed user (backend
# LAUNCH_FREE_ALL_TIERS defaults to "1" in models/user.py; no payment required).
# The /api proxy reaches the backend via Vercel's RAILWAY_BACKEND_URL. Build-time
# vars → take effect on the next Vercel deploy.
#
# NOTE: each V2 page reads `process.env.NEXT_PUBLIC_*_V2 === "true"` (verified in
# src/app/**/page.tsx), so a flag must be the literal "true" to get V2 — an unset
# flag falls back to V1. (The old "코드 default는 V2 active" note was incorrect.)

# Demo OFF (=0): real backend + login. The global fetch patch in lib/demo.ts is a
# no-op unless this is exactly "1", so the app talks to the live backend.
NEXT_PUBLIC_DEMO_MODE=0
NEXT_PUBLIC_MIRROR_HOME=true

# V2 editorial designs — parity with .env.local. SETTINGS_V2 / PROFILE_V2 stay
# unset (= V1), same as local.
NEXT_PUBLIC_HOME_V2=true
NEXT_PUBLIC_REPORTS_V2=true
NEXT_PUBLIC_PORTFOLIO_V2=true
NEXT_PUBLIC_RISK_V2=true
NEXT_PUBLIC_SIGNALS_V2=true
NEXT_PUBLIC_LOGIN_V2=true
NEXT_PUBLIC_SIGNUP_V2=true
