# ══════════════════════════════════════════════════════════════════════════════
# PivoxQuant Frontend — Environment Variables (Example)
# ══════════════════════════════════════════════════════════════════════════════
# NEVER commit real values. Copy to `.env.local` (gitignored by Next.js).
# Production values live in Vercel → Settings → Environment Variables.
# ══════════════════════════════════════════════════════════════════════════════

# ── Public (exposed to browser, must be prefixed NEXT_PUBLIC_) ────────────────
# Backend API base URL. Local dev: http://localhost:5050. Prod: https://api.pivoxquant.com
NEXT_PUBLIC_API_URL=http://localhost:5050
# Canonical site URL (used in metadata + OG tags).
NEXT_PUBLIC_SITE_URL=https://pivoxquant.com
# Web Push VAPID public key (optional — only if push notifications enabled).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<YOUR_VAPID_PUBLIC_KEY>
# Sentry browser DSN. Init is gated on cookie consent (lib/consent.ts) so
# leaving this set is safe — no transport opens until the user accepts
# analytics. Backend SENTRY_DSN is a separate (server-only) variable.
NEXT_PUBLIC_SENTRY_DSN=<YOUR_SENTRY_DSN>


# ── Korean business registration disclosure (전자상거래법 §10) ──────────────────
# Rendered in landing-v2 footer. Leave UNSET on staging — block hides itself.
# 사업자등록증 발급(2026-05-08) 후 prod env 에 실제 값 입력. 사업자 정보는
# 공개 의무 대상이므로 secret 아님 — 단 .env.example 는 placeholder 패턴 유지.
# 상호 (사업자등록증 기재값. e.g. "피복스퀀트(PivoxQuant)").
NEXT_PUBLIC_BUSINESS_NAME=
# 대표자 성명 (e.g. "배상현").
NEXT_PUBLIC_BUSINESS_REPRESENTATIVE=
# 사업자등록번호 (10 digits, e.g. 123-45-67890).
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
# 사업장 주소 (e.g. "서울특별시 성동구 …").
NEXT_PUBLIC_BUSINESS_ADDRESS=
# 업태 (e.g. "정보통신업").
NEXT_PUBLIC_BUSINESS_TYPE=
# 종목 (e.g. "데이터베이스 및 온라인 정보 제공업").
NEXT_PUBLIC_BUSINESS_SUBTYPE=
# 통신판매업 신고번호 (미신고 상태 — 신고 후 입력. e.g. 2026-서울성동-12345).
NEXT_PUBLIC_TELESELLER_REGISTRATION_NUMBER=

# ── v2 design system feature flags ────────────────────────────────────────────
# Each flag toggles between v1 (legacy) and v2 (editorial Vantablack) renders.
# All read at build time — set on Vercel for prod. Default off renders v1.

