# ══════════════════════════════════════════════════════════════════════════════
# PivoxQuant Frontend — Environment Variables (Example)
# ══════════════════════════════════════════════════════════════════════════════
# NEVER commit real values. Copy to `.env.local` (gitignored by Next.js).
# Production values live in Vercel → Settings → Environment Variables.
# ══════════════════════════════════════════════════════════════════════════════

# ── Public (exposed to browser, must be prefixed NEXT_PUBLIC_) ────────────────
# Backend API base URL. Local dev: http://localhost:5050. Prod: https://api.pivoxquant.com
NEXT_PUBLIC_API_URL=http://localhost:5050
# Canonical site URL (used in metadata + OG tags).
NEXT_PUBLIC_SITE_URL=https://pivoxquant.com
# Web Push VAPID public key (optional — only if push notifications enabled).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<YOUR_VAPID_PUBLIC_KEY>
# Alpaca (US paper) UI gate. Default "0" (hidden) pending My Data license
# resolution. Set to "1" to re-surface the connect card/modal in Settings.
# Phase-2 removal of backend routes + autotrader will retire this flag.
NEXT_PUBLIC_ALPACA_ENABLED=0

# ── Server-only (NOT exposed to browser) ──────────────────────────────────────
# Beta gate password. Middleware blocks all routes until this is entered.
# Leave UNSET to disable the gate entirely.
BETA_PASSWORD=<YOUR_BETA_PASSWORD>
# HMAC signing secret for the beta-auth cookie. Must match backend SECRET_KEY
# or be an independent high-entropy value. Generate: openssl rand -hex 32
BETA_SIGNING_SECRET=<YOUR_BETA_SIGNING_SECRET>

# ── Korean business registration disclosure (전자상거래법 §10) ──────────────────
# Rendered in landing-v2 footer. Leave UNSET on staging — block hides itself.
# 사업자 주소 (e.g. "서울특별시 강남구 …").
NEXT_PUBLIC_BUSINESS_ADDRESS=
# 사업자등록번호 (10 digits, e.g. 123-45-67890).
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
# 통신판매업 신고번호 (e.g. 2026-서울강남-12345).
NEXT_PUBLIC_TELESELLER_REGISTRATION_NUMBER=

# ── v2 design system feature flags ────────────────────────────────────────────
# Each flag toggles between v1 (legacy) and v2 (editorial Vantablack) renders.
# All read at build time — set on Vercel for prod. Default off renders v1.
NEXT_PUBLIC_HOME_V2=true
NEXT_PUBLIC_PORTFOLIO_V2=true
NEXT_PUBLIC_RISK_V2=true
NEXT_PUBLIC_SIGNALS_V2=true
NEXT_PUBLIC_REPORTS_V2=true
NEXT_PUBLIC_LOGIN_V2=true
NEXT_PUBLIC_SIGNUP_V2=true
NEXT_PUBLIC_PROFILE_V2=true
NEXT_PUBLIC_SETTINGS_V2=true

# NOTE: SECRET_KEY is referenced by the beta middleware as an HMAC fallback
# when BETA_SIGNING_SECRET is unset. Adding it to this template would
# encourage co-locating a high-trust backend secret in the frontend env;
# wave 2 deliberately skips documenting it here pending a security review.
