#!/usr/bin/env bash
# PivoxQuant — pre-push guard
# ----------------------------------------------------------------------
# 2026-05-19 — GitHub Actions billing 결제 차단 우회용 로컬 마이그레이션.
# alembic head guard + regression guards + 빠른 관련 pytest sanity.
#
# Activation (one-time, per clone):
#     git config core.hooksPath .githooks
#
# Bypass (use sparingly):
#     git push --no-verify
# ----------------------------------------------------------------------
# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> (per push ref)
# We only care that *something* is being pushed; per-ref granularity not needed.

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO_ROOT" || exit 0

fail=0
report() {
  echo "✗ pre-push: $1"
  fail=1
}

echo "→ pre-push: running local equivalents of GitHub Actions checks"
echo "  (GitHub Actions disabled — see docs/dev/local-hooks.md)"
echo ""

# ----------------------------------------------------------------------
# 1) Alembic head guard — single migration chain (no diverged heads).
# Replaces .github/workflows/alembic-head-guard.yml.
# ----------------------------------------------------------------------
echo "[1/3] alembic head guard"
if [ -d "backend" ] && [ -f "backend/alembic.ini" ]; then
  ALEMBIC_DIR="backend"
elif [ -f "migrations/alembic.ini" ]; then
  ALEMBIC_DIR="migrations"
elif [ -f "alembic.ini" ]; then
  ALEMBIC_DIR="."
else
  ALEMBIC_DIR=""
fi

if [ -n "$ALEMBIC_DIR" ]; then
  # Prefer venv alembic if present (avoids PATH ambiguity).
  # Absolute, because the invocation below runs inside `cd "$ALEMBIC_DIR"`.
  # As a relative path this resolved to migrations/venv/bin/alembic and died
  # with exit 127 — the third way this guard was unable to fire (2026-08-30).
  ALEMBIC_BIN=""
  if [ -x "$REPO_ROOT/venv/bin/alembic" ]; then
    ALEMBIC_BIN="$REPO_ROOT/venv/bin/alembic"
  elif command -v alembic >/dev/null 2>&1; then
    ALEMBIC_BIN="alembic"
  fi
  if [ -n "$ALEMBIC_BIN" ]; then
    # 2026-08-30: this guard had never once fired. Two defects, both of
    # which made it report success unconditionally:
    #   1. `^[a-f0-9]+ \(head` only matches hex revision ids. Every revision
    #      in this repo is named (038_scheduled_emails, 049_reflection_…),
    #      so the count was always 0 and `0 -gt 1` is false.
    #   2. `2>&1 || true` folds alembic's own failure into the same path —
    #      when the command errors, output is a stack trace, count is 0, and
    #      the hook prints the check passed.
    # Given alembic 035 reaching prod unapplied caused a P0 in May, a guard
    # that cannot fail is worse than no guard: it manufactures confidence.
    # Now: match named ids too, and treat a non-zero exit as a hard failure
    # rather than a silent pass.
    HEADS_OUT=$(cd "$ALEMBIC_DIR" && "$ALEMBIC_BIN" heads 2>&1)
    ALEMBIC_RC=$?
    HEAD_COUNT=$(echo "$HEADS_OUT" | grep -cE '\(head\)' || true)
    if [ "$ALEMBIC_RC" -ne 0 ]; then
      report "alembic heads failed to run (exit $ALEMBIC_RC) — cannot verify head count:"
      echo "$HEADS_OUT" | tail -5 | sed 's/^/    /'
    elif [ "$HEAD_COUNT" -eq 0 ]; then
      report "alembic heads returned no head lines — the guard cannot verify anything. Output:"
      echo "$HEADS_OUT" | tail -5 | sed 's/^/    /'
    elif [ "$HEAD_COUNT" -gt 1 ] 2>/dev/null; then
      report "alembic has $HEAD_COUNT heads (must be 1). Diverged migrations:"
      echo "$HEADS_OUT" | sed 's/^/    /'
      echo "    Fix: alembic merge -m \"merge heads\" <head1> <head2>"
    else
      echo "  ✓ single head"
    fi
  else
    echo "  (alembic not found — skip; pip install alembic to enable)"
  fi
else
  echo "  (no alembic.ini found — skip)"
fi

# ----------------------------------------------------------------------
# 1b) Stripe webhook signature regression guard (Wave D Sub-wave 1 D4).
# Any commit that touches routes/billing.py MUST keep the signature
# verification call (``stripe.Webhook.construct_event``) intact.
# Removing it would silently accept forged webhook payloads.
# ----------------------------------------------------------------------
echo "[1b] stripe webhook signature guard"
if [ -f "routes/billing.py" ]; then
  if ! grep -q "construct_event" routes/billing.py; then
    report "D4 FAIL: stripe.Webhook.construct_event missing in routes/billing.py"
    echo "    Signature verification removed — push BLOCKED."
    echo "    Restore the call inside the /webhook handler or revert the diff."
  else
    echo "  ✓ construct_event present"
  fi
else
  echo "  (routes/billing.py not found — skip)"
fi

# ----------------------------------------------------------------------
# 2) Regression guards — 9 bug pattern SoT.
# Replaces .github/workflows/regression-guards.yml.
# ----------------------------------------------------------------------
echo "[2/3] regression guards"
if [ -f "scripts/check_regression_guards.py" ]; then
  PY_BIN=""
  if [ -x "./venv/bin/python" ]; then
    PY_BIN="./venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then
    PY_BIN="python3"
  fi
  if [ -n "$PY_BIN" ]; then
    GUARD_OUT=$("$PY_BIN" scripts/check_regression_guards.py 2>&1)
    GUARD_EXIT=$?
    if [ "$GUARD_EXIT" -ne 0 ]; then
      report "regression guards FAIL (exit $GUARD_EXIT):"
      echo "$GUARD_OUT" | head -30 | sed 's/^/    /'
    else
      echo "  ✓ regression guards pass"
    fi
  else
    echo "  (python3 not found — skip)"
  fi
else
  echo "  (scripts/check_regression_guards.py not found — skip)"
fi

# ----------------------------------------------------------------------
# 3) Pytest fast sanity — only changed routes/services + regression tests.
# Replaces (partially) .github/workflows/ci.yml. Full pytest is too slow
# for pre-push — run nightly on developer machines or pre-launch.
# ----------------------------------------------------------------------
echo "[3/3] pytest sanity (changed routes/services + regression)"
PY_BIN=""
if [ -x "./venv/bin/python" ]; then
  PY_BIN="./venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PY_BIN="python3"
fi

if [ -z "$PY_BIN" ] || ! "$PY_BIN" -c "import pytest" 2>/dev/null; then
  echo "  (pytest not available — skip)"
else
  # Determine merge-base with origin/main for changed-file detection.
  BASE_REF="origin/main"
  if ! git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
    BASE_REF=$(git rev-parse HEAD~1 2>/dev/null || echo "HEAD")
  fi
  CHANGED=$(git diff "$BASE_REF"..HEAD --name-only 2>/dev/null | grep -E '^(routes|services|models|engine|quant_models|risk_defense|risk_models|portfolio_models|signal_models|ai_models)/.*\.py$|\.py$' || true)

  # Build pytest target list — regression tests + tests matching changed modules.
  PYTEST_TARGETS=""
  # Always include core regression tests if present.
  for tname in tests/test_pivoxaudit_secret_leak.py tests/test_no_hardcoded_samples.py tests/test_regression_guards.py tests/test_data_integrity_gates.py; do
    [ -f "$tname" ] && PYTEST_TARGETS="$PYTEST_TARGETS $tname"
  done

  # Map changed routes/services → matching tests (best-effort).
  for f in $CHANGED; do
    base=$(basename "$f" .py)
    # tests/test_<basename>.py pattern.
    for cand in "tests/test_${base}.py" "tests/test_${base}_*.py"; do
      for hit in $cand; do
        [ -f "$hit" ] && PYTEST_TARGETS="$PYTEST_TARGETS $hit"
      done
    done
  done

  # Deduplicate.
  PYTEST_TARGETS=$(echo "$PYTEST_TARGETS" | tr ' ' '\n' | sort -u | grep -v '^$' | tr '\n' ' ')

  if [ -z "$PYTEST_TARGETS" ]; then
    echo "  (no relevant tests for changed files — skip)"
  else
    TARGET_COUNT=$(echo "$PYTEST_TARGETS" | wc -w | tr -d ' ')
    echo "  running $TARGET_COUNT test file(s)..."
    # -q quiet, -x stop on first failure, --no-header for compactness.
    PYTEST_OUT=$("$PY_BIN" -m pytest -q -x --no-header $PYTEST_TARGETS 2>&1)
    PYTEST_EXIT=$?
    if [ "$PYTEST_EXIT" -ne 0 ]; then
      report "pytest FAIL (exit $PYTEST_EXIT):"
      echo "$PYTEST_OUT" | tail -40 | sed 's/^/    /'
    else
      echo "  ✓ pytest pass"
    fi
  fi
fi

# ----------------------------------------------------------------------
# 4) Smoke suite — @pytest.mark.smoke tests (warn-only by default).
# 2026-05-19 P0 H3: fast regression safety net before push.
#
# Default mode: WARN-ONLY (exit 0 even on failure).
# Blocking mode: set PIVOX_PREPUSH_BLOCK=1.
#
# If no @pytest.mark.smoke tests exist: setup guide is printed, hook exits 0.
#
# Recommended smoke tests (< 60 s total):
#   @pytest.mark.smoke def test_health()     → GET /api/health == 200
#   @pytest.mark.smoke def test_auth_me()    → GET /api/auth/me == 401 (unauthed)
#   @pytest.mark.smoke def test_portfolio()  → GET /api/portfolio/summary (mock)
# ----------------------------------------------------------------------
echo "[4/4] pytest smoke (blocking — opt out with PIVOX_PREPUSH_BLOCK=0)"

# 2026-08-30: default flipped 0 → 1 (warn-only → blocking).
# The smoke marker set runs in ~1.3s and covers health / auth-required /
# login→portfolio. With all 28 GitHub Actions workflows still `.disabled`
# (billing), this hook is the ONLY gate between a broken auth path and
# origin/main — warn-only meant a red smoke run scrolled past and pushed
# anyway. Opt out per-push with PIVOX_PREPUSH_BLOCK=0 when you genuinely
# need to land a WIP branch; `git push --no-verify` still bypasses all of it.
BLOCK_MODE="${PIVOX_PREPUSH_BLOCK:-1}"
TESTS_DIR="$REPO_ROOT/tests"

if [ ! -d "$TESTS_DIR" ]; then
  echo "  (tests/ directory not found — skip)"
else
  # Anchored to line start: the unanchored form also counted the prose in
  # test_smoke.py's module docstring ("Marked ``@pytest.mark.smoke`` so the
  # pre-push hook can gate on them"), so the hook reported 4 markers for 3
  # real tests. A gate that miscounts its own coverage invites doubt about
  # the rest of what it reports. (2026-08-30)
  SMOKE_COUNT=$(grep -rE '^\s*@pytest\.mark\.smoke' "$TESTS_DIR" 2>/dev/null | wc -l | tr -d ' ')

  if [ "$SMOKE_COUNT" -eq 0 ]; then
    echo ""
    echo "  No @pytest.mark.smoke tests found — setup guide:"
    echo ""
    echo "    # pytest.ini or pyproject.toml:"
    echo "    # [pytest] markers = smoke: fast end-to-end sanity checks (< 60 s)"
    echo ""
    echo "    # In test file:"
    echo "    # @pytest.mark.smoke"
    echo "    # def test_health(client):"
    echo "    #     assert client.get('/api/health').status_code == 200"
    echo ""
    echo "  Recommended: add 3-5 smoke tests covering /api/health, auth, and portfolio."
    echo "  This hook will start enforcing them automatically once markers are present."
    echo ""
  else
    # Invoke via `python -m pytest` rather than the bare ./venv/bin/pytest
    # console script: after the stockpilot→pivoxquant project rename the
    # script's shebang carried a stale interpreter path ("bad interpreter:
    # .../stockpilot/venv/.../python3.12"), so a direct call failed before
    # any test ran. `python -m pytest` is immune to that. Also dropped
    # --timeout=60 (pytest-timeout is not installed; smoke is fast anyway).
    SMOKE_PY=""
    if [ -x "$REPO_ROOT/venv/bin/python" ]; then
      SMOKE_PY="$REPO_ROOT/venv/bin/python"
    elif command -v python3 >/dev/null 2>&1; then
      SMOKE_PY="python3"
    fi

    if [ -z "$SMOKE_PY" ] || ! "$SMOKE_PY" -c "import pytest" 2>/dev/null; then
      echo "  (pytest not available — skip; pip install pytest to enable)"
    else
      echo "  running $SMOKE_COUNT smoke marker(s)..."
      SMOKE_OUT=$("$SMOKE_PY" -m pytest "$TESTS_DIR" -m smoke -x --tb=short -q 2>&1)
      SMOKE_EXIT=$?

      if [ "$SMOKE_EXIT" -ne 0 ]; then
        echo ""
        echo "  --- smoke FAILURES ---"
        echo "$SMOKE_OUT" | tail -25 | sed 's/^/  /'
        echo "  ---"
        echo ""
        if [ "$BLOCK_MODE" = "1" ]; then
          report "smoke tests FAILED — push blocked (override: PIVOX_PREPUSH_BLOCK=0 git push)"
        else
          echo "  WARNING: smoke tests failed (PIVOX_PREPUSH_BLOCK=0 — push continues)."
          echo "  Emergency bypass:  git push --no-verify"
          echo ""
        fi
      else
        echo "  smoke PASSED ($SMOKE_COUNT markers, exit 0)"
      fi
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Push blocked. To override (only if you are certain):"
  echo "    git push --no-verify"
  echo "Re-enable GitHub Actions after billing: see docs/dev/local-hooks.md"
  exit 1
fi
exit 0
