#!/usr/bin/env bash
# PivoxQuant — pre-commit secret guard
# ----------------------------------------------------------------------
# 2026-05-10 — Protects against the recurring beta-password leak pattern
# (pivoxaudit / pivoxaudit2) and other obvious secret regressions.
#
# Activation (one-time, per clone):
#     git config core.hooksPath .githooks
#
# Bypass (use sparingly, requires explicit ack):
#     git commit --no-verify
#
# CI legal-guard.yml mirrors the beta-password check on the server side
# so a bypass here still gets caught before merge.
# ----------------------------------------------------------------------
# macOS ships bash 3.2 — avoid bash-4-only features (mapfile, etc).

# Only inspect the staged diff (added/changed/copied/renamed files).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)
[ -z "$STAGED" ] && exit 0

fail=0
report() {
  echo "✗ pre-commit: $1"
  fail=1
}

# 1) Block forbidden file extensions outright.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    .env|.env.*|*.env)              report "secret file staged: $f (move to Vercel/Railway env)";;
    *.db|*.sqlite|*.sqlite3)        report "binary DB staged: $f (add to .gitignore)";;
    *.pem|*.key|*.p12|*.pfx)        report "key material staged: $f";;
  esac
done <<EOF
$STAGED
EOF

# 2) SNAPSHOT_DATE staleness guard (market-ticker.tsx only).
# Runs BEFORE the SCAN block so the early-exit on empty SCAN does not swallow it.
# Only fires when market-ticker.tsx is staged — no impact on unrelated commits.
# Uses python3 date arithmetic — avoids BSD vs GNU date incompatibility on macOS.
# python3 is guaranteed on macOS 10.15+.
#
# This makes the aspirational comment in market-ticker.tsx real:
#   "pre-commit stale-guard which fails the commit if this date is older than 14 days"
# Bypass: git commit --no-verify (same as all other checks here).
if echo "$STAGED" | grep -q 'frontend/src/components/landing/market-ticker\.tsx'; then
  # Get the new value from the diff (+lines only), falling back to git-show
  # of the staged blob so `git add -p` partial stages also work.
  SNAP_LINE=$(git diff --cached -U0 -- 'frontend/src/components/landing/market-ticker.tsx' \
    | grep '^+export const SNAPSHOT_DATE' | head -1)
  if [ -z "$SNAP_LINE" ]; then
    SNAP_LINE=$(git show :frontend/src/components/landing/market-ticker.tsx 2>/dev/null \
      | grep 'export const SNAPSHOT_DATE' | head -1)
  fi
  if [ -n "$SNAP_LINE" ]; then
    SNAP_DATE=$(printf '%s' "$SNAP_LINE" | python3 -c "
import sys, re
line = sys.stdin.read()
m = re.search(r'SNAPSHOT_DATE\s*=\s*[\"\x27]([0-9]{4}-[0-9]{2}-[0-9]{2})[\"\x27]', line)
print(m.group(1) if m else '')
" 2>/dev/null)
    if [ -n "$SNAP_DATE" ]; then
      DAYS_STALE=$(python3 -c "
from datetime import date
snap = date.fromisoformat('$SNAP_DATE')
diff = (date.today() - snap).days
print(diff)
" 2>/dev/null)
      if [ -n "$DAYS_STALE" ] && [ "$DAYS_STALE" -gt 14 ] 2>/dev/null; then
        report "market-ticker.tsx SNAPSHOT_DATE ($SNAP_DATE) is ${DAYS_STALE} days stale (>14). Refresh values from FMP/FRED/KIS before commit."
      fi
    fi
  fi
fi

# 3) Pattern scans on staged content (catches partial stages — only +added lines).
# W7.3: exclude self-referencing guard files so the hook does not catch its
# own regex / threat-model literals.
SCAN=$(git diff --cached -U0 --diff-filter=ACMR \
  ':!.github/workflows/legal-guard.yml' \
  ':!tests/test_pivoxaudit_secret_leak.py' \
  ':!.githooks/pre-commit' \
  2>/dev/null || true)
[ -z "$SCAN" ] && { [ "$fail" -eq 0 ] && exit 0 || exit 1; }

# Beta password (the recurring incident). W7.3 narrowed to word boundary
# so `test_pivoxaudit_secret_leak` / `TestNoPivoxauditSecretLeak` /
# `pivoxaudit_legacy` no longer self-match.
if echo "$SCAN" | grep -wE '^\+.*pivoxaudit[0-9]*' >/dev/null 2>&1; then
  report "beta password literal in staged diff (regex \\bpivoxaudit[0-9]*\\b, W7.3 word-bounded) — use Vercel env reference instead"
fi

# Sentry DSN.
if echo "$SCAN" | grep -E '^\+.*https://[a-f0-9]{32}@[a-z0-9.-]+\.ingest\.[a-z.]+sentry\.io' >/dev/null 2>&1; then
  report "Sentry DSN in staged diff — rotate via Sentry console + use NEXT_PUBLIC_SENTRY_DSN env"
fi

# Anthropic API key.
if echo "$SCAN" | grep -E '^\+.*sk-ant-[A-Za-z0-9_-]{20,}' >/dev/null 2>&1; then
  report "Anthropic API key in staged diff — rotate immediately"
fi

# Generic AWS access key.
if echo "$SCAN" | grep -E '^\+.*AKIA[0-9A-Z]{16}' >/dev/null 2>&1; then
  report "AWS access key id in staged diff"
fi

# Stripe secret key.
if echo "$SCAN" | grep -E '^\+.*sk_(live|test)_[A-Za-z0-9]{20,}' >/dev/null 2>&1; then
  report "Stripe secret key in staged diff"
fi

# ----------------------------------------------------------------------
# 4) Legal-guard grep — 자본시장법 금지어 (BUY/SELL/HOLD/recommend/advice/추천/조언)
# 단 시그널 enum 값(SignalType.POSITIVE 등 트레이드 액션 필드)은 화이트리스트.
# Scope: 사용자 노출 표면만 (frontend/src/app, routes, services, templates).
# Source: CLAUDE.md "중요 원칙" §시그널 라벨.
# ----------------------------------------------------------------------
LEGAL_SCAN_FILES=$(echo "$STAGED" | grep -E '^(frontend/src/app|routes|services|templates)/.*\.(py|ts|tsx|jsx|js|html)$' || true)
if [ -n "$LEGAL_SCAN_FILES" ]; then
  LEGAL_HITS=$(git diff --cached -U0 --diff-filter=ACMR -- $LEGAL_SCAN_FILES 2>/dev/null \
    | grep -nE '^\+.*(\bBUY\b|\bSELL\b|\bHOLD\b|\brecommend|\badvice\b|추천|조언)' \
    | grep -viE '(SignalType|trade\.action|action:|action =|"action"|TradeAction|# noqa: legal|// legal-ok|test_|\.test\.|spec\.|fixture)' \
    || true)
  if [ -n "$LEGAL_HITS" ]; then
    report "legal-guard: 금지어 (BUY/SELL/HOLD/recommend/advice/추천/조언) detected in user-facing surface:"
    echo "$LEGAL_HITS" | head -10 | sed 's/^/    /'
    echo "    화이트리스트: SignalType enum / trade.action 필드 / test fixture (자동 제외됨)"
    echo "    의도된 경우: # noqa: legal 또는 // legal-ok 주석 추가"
  fi
fi

# ----------------------------------------------------------------------
# 5) Frozen-file diff guard — hard_frozen 7건 (.claude/frozen_files.yaml SoT)
# v45.4 G3 frozen-file-diff-guard agent SoT.
# 변경 시 commit message에 escape token 필수:
#   - "cache-poisoning-sentinel approved"  (services/ai/models.py)
#   - "fx-consistency-guard approved"      (services/quant/portfolio.py)
#   - "legal-kr-fintech approved"          (services/ai/models.py prompt injection)
#   - "CEO override: <reason>"             (any hard_frozen)
# ----------------------------------------------------------------------
FROZEN_PATHS="services/quant/engine.py services/quant/models.py services/quant/risk_metrics.py services/quant/risk_defense.py services/quant/portfolio.py services/quant/signals.py services/ai/models.py"
FROZEN_HITS=""
for fp in $FROZEN_PATHS; do
  if echo "$STAGED" | grep -qx "$fp"; then
    FROZEN_HITS="${FROZEN_HITS}${fp}\n"
  fi
done
if [ -n "$FROZEN_HITS" ]; then
  # commit message는 아직 없음 (pre-commit 단계). COMMIT_EDITMSG 또는 -m 파라미터는
  # 현재 hook에서 직접 접근 불가 → MERGE_MSG/COMMIT_EDITMSG 파일 확인.
  CMSG_FILE=".git/COMMIT_EDITMSG"
  ESCAPE_OK=0
  if [ -f "$CMSG_FILE" ]; then
    if grep -qiE '(cache-poisoning-sentinel approved|fx-consistency-guard approved|legal-kr-fintech approved|CEO override:)' "$CMSG_FILE"; then
      ESCAPE_OK=1
    fi
  fi
  if [ "$ESCAPE_OK" -ne 1 ]; then
    report "frozen-file-diff-guard: hard_frozen file(s) staged without escape token:"
    printf "    %b" "$FROZEN_HITS"
    echo "    SoT: .claude/frozen_files.yaml"
    echo "    필수 commit message escape token (택1):"
    echo "      - 'cache-poisoning-sentinel approved'"
    echo "      - 'fx-consistency-guard approved'"
    echo "      - 'legal-kr-fintech approved'"
    echo "      - 'CEO override: <reason>'"
  fi
fi

# ----------------------------------------------------------------------
# 6) Ruff check — backend python lint (선택, ruff 미설치 시 skip).
# Staged .py 파일만 빠르게 검사 (전체 codebase는 느림).
# ----------------------------------------------------------------------
PY_STAGED=$(echo "$STAGED" | grep -E '\.py$' || true)
if [ -n "$PY_STAGED" ]; then
  if command -v ruff >/dev/null 2>&1; then
    RUFF_OUT=$(ruff check $PY_STAGED 2>&1 || true)
    if echo "$RUFF_OUT" | grep -qE '^[^ ].*:[0-9]+:[0-9]+:'; then
      report "ruff check: lint violations in staged Python files:"
      echo "$RUFF_OUT" | head -20 | sed 's/^/    /'
    fi
  elif [ -x "./venv/bin/ruff" ]; then
    RUFF_OUT=$(./venv/bin/ruff check $PY_STAGED 2>&1 || true)
    if echo "$RUFF_OUT" | grep -qE '^[^ ].*:[0-9]+:[0-9]+:'; then
      report "ruff check: lint violations in staged Python files:"
      echo "$RUFF_OUT" | head -20 | sed 's/^/    /'
    fi
  else
    echo "  (ruff not installed — skip Python lint; pip install ruff to enable)"
  fi
fi

# ----------------------------------------------------------------------
# 7) Extended secret scan — GitHub PAT / OAuth / Dev login secrets.
# ----------------------------------------------------------------------
if [ -n "$SCAN" ]; then
  if echo "$SCAN" | grep -E '^\+.*ghp_[A-Za-z0-9]{36}' >/dev/null 2>&1; then
    report "GitHub personal access token (ghp_...) in staged diff"
  fi
  if echo "$SCAN" | grep -E '^\+.*ghs_[A-Za-z0-9]{36}' >/dev/null 2>&1; then
    report "GitHub server token (ghs_...) in staged diff"
  fi
  if echo "$SCAN" | grep -wE "^\+.*(GOOGLE_OAUTH_CLIENT_SECRET|DEV_LOGIN_SECRET|KAKAO_CLIENT_SECRET)\s*=\s*['\"][A-Za-z0-9_-]{8,}" >/dev/null 2>&1; then
    report "OAuth/dev secret literal value in staged diff — use env var reference"
  fi
fi

# ----------------------------------------------------------------------
# 8) detect-secrets — entropy + pattern baseline scan.
# 2026-05-19 P0 H1: complements the hand-written regex guards above with
# Yelp detect-secrets (open source, PyPI, 0 cost).
#
# Requires: pip install detect-secrets  (added to requirements-dev.txt)
# Baseline:  .secrets.baseline (committed — audited 4 known FP entries)
#   - models/user_referral.py:24  Base64HighEntropy  → _REFERRAL_ALPHABET constant (not a secret)
#   - services/email/brevo_provider.py:82-83  SecretKeyword → env-var key names (not values)
#   - services/email/sendgrid_provider.py:61  SecretKeyword → env-var key name (not value)
#
# detect-secrets-hook only checks staged files (delta-only, fast).
# Skips if detect-secrets not installed (graceful degradation).
# Regenerate baseline: detect-secrets scan routes/ services/ models/ .githooks/ scripts/ > .secrets.baseline
# ----------------------------------------------------------------------
if [ -n "$STAGED" ]; then
  if command -v detect-secrets-hook >/dev/null 2>&1; then
    BASELINE_FILE=".secrets.baseline"
    if [ ! -f "$BASELINE_FILE" ]; then
      echo "  (detect-secrets: .secrets.baseline not found — run: detect-secrets scan > .secrets.baseline)"
    else
      # Convert newline-separated file list to arguments.
      DS_STAGED=$(echo "$STAGED" | tr '\n' ' ')
      # shellcheck disable=SC2086
      DS_OUT=$(detect-secrets-hook --baseline "$BASELINE_FILE" $DS_STAGED 2>&1 || true)
      DS_EXIT=$?
      if [ "$DS_EXIT" -ne 0 ] && echo "$DS_OUT" | grep -q 'Potential'; then
        report "detect-secrets: new secret(s) detected in staged files (not in .secrets.baseline):"
        echo "$DS_OUT" | head -20 | sed 's/^/    /'
        echo "    If this is a false positive: detect-secrets scan > .secrets.baseline && git add .secrets.baseline"
        echo "    If this is a real secret: remove it, rotate credentials, then re-commit"
      fi
    fi
  else
    echo "  (detect-secrets not installed — skip entropy scan; pip install detect-secrets to enable)"
  fi
fi

# ----------------------------------------------------------------------
# 9) TypeScript type-check — tsc --noEmit on staged TS/TSX files.
# 2026-05-19 P0 H2: complements ruff (§6) for the frontend layer.
# Requires: npx (bundled with Node.js — already required for Next.js dev)
# Skip if no TS/TSX files staged, or if frontend/tsconfig.json missing.
# ----------------------------------------------------------------------
TS_STAGED=$(echo "$STAGED" | grep -E '\.(ts|tsx)$' || true)
if [ -n "$TS_STAGED" ]; then
  TSCONFIG="frontend/tsconfig.json"
  if [ ! -f "$TSCONFIG" ]; then
    echo "  (tsc: $TSCONFIG not found — skip TypeScript check)"
  elif ! command -v npx >/dev/null 2>&1; then
    echo "  (tsc: npx not found — skip TypeScript check; install Node.js to enable)"
  else
    echo "  tsc --noEmit ($(echo "$TS_STAGED" | wc -l | tr -d ' ') TS/TSX files staged)..."
    TSC_OUT=$(cd frontend && npx tsc --noEmit -p tsconfig.json 2>&1 || true)
    TSC_EXIT=$?
    if [ "$TSC_EXIT" -ne 0 ]; then
      # Filter to only errors (not warnings) to reduce noise.
      TSC_ERRORS=$(echo "$TSC_OUT" | grep -E 'error TS[0-9]+' || true)
      if [ -n "$TSC_ERRORS" ]; then
        report "tsc: TypeScript errors in staged files:"
        echo "$TSC_ERRORS" | head -20 | sed 's/^/    /'
        echo "    Fix type errors or suppress with // @ts-ignore (with comment explaining why)"
      fi
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit blocked. To override (only if you are certain):"
  echo "    git commit --no-verify"
  echo "Server-side legal-guard.yml (currently DISABLED — see docs/dev/local-hooks.md)"
  echo "will re-check on push when GitHub Actions billing is re-enabled."
  exit 1
fi
exit 0
